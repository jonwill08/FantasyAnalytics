// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "api/data/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Position {
  QB
  RB
  WR
  TE
  K
  DEF
}

enum PlayerSource {
  USER_ADDED
  BULK_IMPORT
  TRENDING
  SLEEPER_SYNC
}

// Core tables
model Team {
  id           String   @id @default(uuid()) @db.Uuid
  externalKey  String   @unique // Sleeper team ID, ESPN team ID, etc.
  name         String
  abbreviation String? @unique
  conference   String?
  division     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  players      Player[]

  @@index([externalKey])
}

model Player {
  id            String        @id @default(uuid()) @db.Uuid
  externalKey   String        @unique // Sleeper player ID, ESPN player ID, etc.
  fullName      String
  firstName     String?
  lastName      String?
  position      Position
  status        String        @default("active") // active, injured, retired, suspended
  rookieYear    Int?
  heightInches  Int?
  weightLbs     Int?
  dob           DateTime?     @db.Date
  source        PlayerSource  @default(USER_ADDED)
  lastFetchedAt DateTime?     // When we last synced from external API
  rawData       Json?          // Store full API response for reference
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  teamId        String?       @db.Uuid
  team          Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)

  userPlayers   UserPlayer[]

  @@index([teamId])
  @@index([position])
  @@index([lastName])
  @@index([source])
  @@index([externalKey])
}

// User management (Clerk integration)
model User {
  id            String        @id // Clerk user ID
  email         String?       @unique
  firstName     String?
  lastName      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userPlayers   UserPlayer[]
  sleeperInfo   SleeperUserInfo?

  @@index([email])
}

// Junction table: Users and their tracked players
model UserPlayer {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        // Clerk user ID
  playerId      String        @db.Uuid
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  player        Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([userId, playerId])
  @@index([userId])
  @@index([playerId])
}

// Sleeper integration
model SleeperUserInfo {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @unique // Clerk user ID
  sleeperId       String        @unique
  username        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leagues         SleeperLeagueInfo[]

  @@index([sleeperId])
}

model SleeperLeagueInfo {
  id                String        @id @default(uuid()) @db.Uuid
  sleeperUserInfoId String        @db.Uuid
  leagueId          String        @unique
  season            Int           @default(2025)
  rosterPositions   String[]      @default([])
  scoringSettings   Json?         // Store scoring settings as JSON
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sleeperUserInfo   SleeperUserInfo @relation(fields: [sleeperUserInfoId], references: [id], onDelete: Cascade)
  rosters           SleeperLeagueRoster[]

  @@index([leagueId])
  @@index([sleeperUserInfoId])
}

model SleeperLeagueRoster {
  id                String        @id @default(uuid()) @db.Uuid
  sleeperLeagueInfoId String      @db.Uuid
  rosterId          String        @unique
  players           String[]      @default([]) // Array of Sleeper player IDs
  reserve           String[]      @default([])
  starters          String[]      @default([])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sleeperLeagueInfo SleeperLeagueInfo @relation(fields: [sleeperLeagueInfoId], references: [id], onDelete: Cascade)

  @@index([rosterId])
  @@index([sleeperLeagueInfoId])
}

